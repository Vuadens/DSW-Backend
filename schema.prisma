generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" 
  url      = env("DATABASE_URL")
}

model Plan {
  idPlan        Int      @id @default(autoincrement())
  nombre        String
  tipo          String?  // Premium-Pro-Estandar
  descripcion   String?
  precio        Decimal
  duracionMeses Int?     @default(1)
  activo        Boolean  @default(true) // Para dar de baja o no el plan
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Profesor {
   idProfesor  Int @id @default(autoincrement())
   nombre String
   apellido String
   cargo String
}