generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Plan {
  idPlan        Int      @id @default(autoincrement())
  nombre        String
  tipo          String?
  descripcion   String?
  precio        Decimal
  duracionMeses Int?     @default(1)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  socios      Socio[]
  // Actividades que incluye el plan: un socio solo reserva clases de estas actividades.
  actividades Actividad[]
}

// Superclase del modelo de dominio. Profesor, Socio y Administrador la
// especializan con una tabla por subtipo cuya PK es también FK a Persona
// (clave primaria compartida): cada persona tiene un único id, idPersona.
model Persona {
  idPersona Int      @id @default(autoincrement())
  dni       String   @unique
  nombre    String
  apellido  String
  telefono  String
  fechaNac  DateTime

  profesor      Profesor?
  socio         Socio?
  administrador Administrador?
  usuario       Usuario?
}

model Profesor {
  idPersona  Int     @id
  persona    Persona @relation(fields: [idPersona], references: [idPersona], onDelete: Cascade)
  cargo      String
  clases     Clase[]
  turnos     Turno[]
}

model Administrador {
  idPersona Int     @id
  persona   Persona @relation(fields: [idPersona], references: [idPersona], onDelete: Cascade)
}


// Turno de trabajo del personal (franja horaria de un día), independiente de las
// clases. Relación muchos a muchos con Profesor: un turno lo cubren varios
// profesores y un profesor puede cubrir varios turnos.
model Turno {
  idTurno    Int        @id @default(autoincrement())
  nombre     String?
  diaSemana  DiaSemana
  horaDesde  String     @db.VarChar(5) // "HH:mm"
  horaHasta  String     @db.VarChar(5) // "HH:mm"
  activo     Boolean    @default(true)
  profesores Profesor[]

  @@index([diaSemana])
}

model Socio {
  idPersona  Int       @id
  persona    Persona   @relation(fields: [idPersona], references: [idPersona], onDelete: Cascade)
  fechaAlta  DateTime  @default(now())
  fechaBaja  DateTime?

  planId Int
  plan   Plan    @relation(fields: [planId], references: [idPlan])
  cuotas Cuota[]
  inscripciones Inscripcion[]
}

model Actividad {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  cupoMaximo  Int
  creadaEn    DateTime @default(now())
  clases      Clase[]
  planes      Plan[]
}


// entidad 'Clase' con su dictado (dia y horario) en una sola tabla buscando
//respetar la proposal, veo mejor esta solucion que el actual MD, habria que actualizarlo.

model Clase {
  idClase     Int       @id @default(autoincrement())
  diaSemana   DiaSemana
  horaDesde   String    @db.VarChar(5) // "HH:mm"
  horaHasta   String    @db.VarChar(5) // "HH:mm"
  cupo        Int

  idActividad Int
  actividad   Actividad @relation(fields: [idActividad], references: [id])

  idProfesor  Int
  profesor    Profesor  @relation(fields: [idProfesor], references: [idPersona])

  inscripciones Inscripcion[]

  @@index([idActividad])
  @@index([idProfesor])
  @@index([diaSemana])
}

// Justificacion de por qué es un "crud dependiente":
// Depende de Actividad (que se dicta en la clase) y de Profesor (quien lo dicta).

//nuevo tipo de objeto para poder fusionar clase con dictado
enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model Inscripcion {
  idInscripcion    Int       @id @default(autoincrement())
  fechaInscripcion DateTime  @default(now())
  activo           Boolean  @default(true)

  // Relación con Socio
  idSocio          Int
  socio            Socio     @relation(fields: [idSocio], references: [idPersona])

  // Relación con Clase
  idClase          Int
  clase            Clase     @relation(fields: [idClase], references: [idClase])

  // Un socio no debería inscribirse dos veces a la misma clase
  @@unique([idSocio, idClase])
  @@index([idSocio])
  @@index([idClase])
}

enum Rol {
  ADMINISTRADOR
  PROFESOR
  SOCIO
}

// Se accede con email o con el DNI de la persona. `usuario` es solo un nombre visible.
model Usuario {
  idUsuario   Int      @id @default(autoincrement())
  email       String   @unique
  usuario     String?
  passwordHash String
  rol         Rol
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  personaId   Int      @unique
  persona     Persona  @relation(fields: [personaId], references: [idPersona], onDelete: Cascade)
}

model Cuota {
  idCuota   Int       @id @default(autoincrement())
  mesAnio   DateTime
  fechaPago DateTime  @default(now())
  valor     Decimal

  socioId Int
  socio   Socio @relation(fields: [socioId], references: [idPersona])

  @@unique([socioId, mesAnio])
}
