generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Plan {
  idPlan        Int      @id @default(autoincrement())
  nombre        String
  tipo          String?
  descripcion   String?
  precio        Decimal
  duracionMeses Int?     @default(1)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Profesor {
  idProfesor Int        @id @default(autoincrement())
  nombre     String
  apellido   String
  cargo      String
  clases     Clase[]
  turnos     Turno[]
}

model Socio {
  idSocio       Int           @id @default(autoincrement())
  DNI           String
  apellido      String
  nombre        String
  email         String
  telefono      String
  direccion     String
  fecha_baja    DateTime?
  fecha_nac     DateTime
  inscripciones Inscripcion[]
}

model Actividad {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  cupoMaximo  Int
  creadaEn    DateTime @default(now())
  clases      Clase[]
}


// entidad 'Clase' con su dictado (dia y horario) en una sola tabla buscando 
//respetar la proposal, veo mejor esta solucion que el actual MD, habria que actualizarlo.

model Clase {
  idClase       Int           @id @default(autoincrement())
  diaSemana     DiaSemana
  horaDesde     String        @db.VarChar(5)
  horaHasta     String        @db.VarChar(5)
  cupo          Int

  idActividad   Int
  actividad     Actividad     @relation(fields: [idActividad], references: [id])

  idProfesor    Int
  profesor      Profesor      @relation(fields: [idProfesor], references: [idProfesor])

  inscripciones Inscripcion[]

  @@index([idActividad])
  @@index([idProfesor])
  @@index([diaSemana])
}

model Inscripcion {
  idInscripcion    Int      @id @default(autoincrement())
  fechaInscripcion DateTime @default(now())
  activo           Boolean  @default(true)

  idSocio          Int
  socio            Socio    @relation(fields: [idSocio], references: [idSocio])

  idClase          Int
  clase            Clase    @relation(fields: [idClase], references: [idClase])

  @@unique([idSocio, idClase])
  @@index([idSocio])
  @@index([idClase])
}

model Turno {
  idTurno     Int        @id @default(autoincrement())
  nombre      String?    // "Mañana", "Tarde", "Noche"
  diaSemana   DiaSemana
  horaDesde   String     @db.VarChar(5) // "HH:mm"
  horaHasta   String     @db.VarChar(5) // "HH:mm"
  activo      Boolean    @default(true)

  profesores  Profesor[]

  @@index([diaSemana])
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}